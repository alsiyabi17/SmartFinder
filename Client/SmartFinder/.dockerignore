# Dependencies — always installed fresh inside the container
node_modules

# Build output
dist
build

# Local environment files (never copy secrets into images)
.env
.env.local
.env.*.local

# Git metadata
.git
.gitignore

# Editor / IDE folders
.vscode
.idea

# Logs and OS junk
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Test / coverage output
coverage

# Docker files themselves don't need to be inside the image
Dockerfile
Dockerfile.prod
.dockerignore
